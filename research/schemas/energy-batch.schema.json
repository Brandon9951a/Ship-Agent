{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ship-agent/research/schemas/energy-batch.schema.json",
  "title": "EnergyBatchRequest / EnergyBatchResult",
  "description": "Tenergy → Tspeed 的批量预测契约（联调接口 v2 第 4 节）。每个样本表示 [start_offset_s, start_offset_s + duration_s)，duration_s > 0；候选之间可有时长差异，绝不用数组下标配对。",
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["source_id", "kind"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["document", "user", "measurement", "assumption", "tool"] },
        "locator": { "type": ["string", "null"] },
        "confirmed": { "type": "boolean" },
        "note": { "type": ["string", "null"] },
        "mode": { "enum": ["measured", "replay", "simulation", null] }
      }
    },
    "trajectoryPoint": {
      "type": "object",
      "required": ["segment_id", "phase", "start_offset_s", "duration_s", "planned_speed_kmh"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["sailing", "waiting", "berthing", "charging"] },
        "start_offset_s": { "type": "number", "minimum": 0 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "planned_speed_kmh": {
          "type": ["number", "null"], "minimum": 0,
          "description": "区间计划航速（斜坡上为区间平均速度）。非航行阶段可为 0 或 null（明确未知）"
        },
        "target_speed_kmh": {
          "type": ["number", "null"], "minimum": 0,
          "description": "该航段的目标巡航航速（决策变量）。斜坡区间的平均速度不能反推此值"
        },
        "interval_kind": { "enum": ["accel", "cruise", "decel", "waiting", null] },
        "environment_ref": { "type": ["string", "null"] },
        "source_ref": { "oneOf": [{ "$ref": "#/$defs/sourceRef" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "trajectory"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "trajectory": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/trajectoryPoint" }
        },
        "search_seed": { "type": ["integer", "null"] },
        "generation": { "type": ["integer", "null"], "minimum": 0 },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "powerPoint": {
      "type": "object",
      "required": ["segment_id", "phase", "start_offset_s", "duration_s",
                   "planned_speed_kmh", "predicted_motor_power_kw", "motor_energy_kwh"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["sailing", "waiting", "berthing", "charging"] },
        "start_offset_s": { "type": "number", "minimum": 0 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "planned_speed_kmh": { "type": ["number", "null"], "minimum": 0 },
        "target_speed_kmh": { "type": ["number", "null"], "minimum": 0 },
        "interval_kind": { "enum": ["accel", "cruise", "decel", "waiting", null] },
        "predicted_motor_power_kw": {
          "type": ["number", "null"],
          "description": "主推进电机侧功率；负值须由模型规则显式标注，不能默认为 0"
        },
        "motor_energy_kwh": {
          "type": ["number", "null"],
          "description": "必须等于 predicted_motor_power_kw × duration_s / 3600"
        },
        "applicability_flag": { "type": ["string", "null"] },
        "quality_flags": {
          "type": "array",
          "items": { "enum": ["extrapolated", "interpolated", "resampled", "missing",
                               "unpredicted", "conflict", "assumption", "simulation",
                               "coarse_grid"] }
        }
      },
      "additionalProperties": false
    },
    "energyResult": {
      "type": "object",
      "required": ["candidate_id", "outcome_code"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "outcome_code": { "type": "string", "minLength": 1 },
        "power_points": { "type": "array", "items": { "$ref": "#/$defs/powerPoint" } },
        "segment_summaries": { "type": "array", "items": { "type": "object" } },
        "total_summary": { "type": ["object", "null"] },
        "coverage": { "type": ["object", "null"] },
        "artifact_ref": { "type": ["object", "null"] },
        "diagnostics": { "type": "array", "items": { "type": "object" } },
        "model_version": { "type": ["string", "null"] },
        "cache_hit": { "type": "boolean" },
        "runtime_ms": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "EnergyBatchRequest",
      "type": "object",
      "required": ["candidates", "history_ref", "environment_scenario_ref",
                   "model_version", "integration_rule", "schema_version"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "history_ref": { "type": "string", "minLength": 1 },
        "environment_scenario_ref": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "integration_rule": { "type": "string", "minLength": 1 },
        "task_id": { "type": ["string", "null"] },
        "request_revision": { "type": ["integer", "string", "null"] },
        "snapshot_id": { "type": ["string", "null"] },
        "scenario_id": { "type": ["string", "null"] },
        "call_id": { "type": ["string", "null"] },
        "parent_call_id": { "type": ["string", "null"] },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "candidates": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/candidate" }
        }
      }
    },
    {
      "title": "EnergyBatchResult",
      "type": "object",
      "required": ["results", "model_version", "integration_rule", "schema_version"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "integration_rule": { "type": "string", "minLength": 1 },
        "call_id": { "type": ["string", "null"] },
        "parent_call_id": { "type": ["string", "null"] },
        "batch_runtime_ms": { "type": ["number", "null"], "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "array", "items": { "type": "object" } },
        "results": { "type": "array", "items": { "$ref": "#/$defs/energyResult" } }
      }
    }
  ]
}
