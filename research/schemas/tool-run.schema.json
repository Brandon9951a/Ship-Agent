{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ship-agent/research/schemas/tool-run.schema.json",
  "title": "ToolRun",
  "description": "五工具统一状态信封（联调接口 v2 第 3 节）。execution_status 只区分 completed/failed/cancelled；工程结果由 outcome_code 表达。",
  "type": "object",
  "required": [
    "schema_version", "tool_name", "call_id", "execution_status", "outcome_code",
    "started_at", "finished_at", "diagnostics"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "parent_call_id": { "type": ["string", "null"] },
    "input_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "request_revision": { "type": ["integer", "string", "null"] },
    "snapshot_id": { "type": ["string", "null"] },
    "scenario_id": { "type": ["string", "null"] },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "execution_status": {
      "enum": ["completed", "failed", "cancelled"],
      "description": "needs_input/invalid_input/search_unresolved/not_supported 都是正常返回的工程结果，因此为 completed"
    },
    "outcome_code": {
      "enum": ["ok", "needs_input", "invalid_input", "model_out_of_domain",
               "search_unresolved", "infeasible_under_assumptions", "tool_error",
               "grid_unresolved", "not_supported"]
    },
    "payload_ref": { "type": ["string", "null"] },
    "model_or_algorithm_version": { "type": ["string", "null"] },
    "config_hash": { "type": ["string", "null"] },
    "runtime_ms": { "type": ["number", "null"], "minimum": 0 },
    "payload": { "type": ["object", "null"] },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["source_id", "kind"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["document", "user", "measurement", "assumption", "tool"] },
        "locator": { "type": ["string", "null"] },
        "confirmed": { "type": "boolean" },
        "note": { "type": ["string", "null"] },
        "mode": { "enum": ["measured", "replay", "simulation", null] }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["stage", "code"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": ["string", "null"] },
        "time_interval_s": {
          "type": ["array", "null"],
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2, "maxItems": 2
        },
        "segment_id": { "type": ["string", "null"] },
        "field_ref": { "type": ["string", "null"] },
        "observed": { "type": ["number", "string", "null"] },
        "limit": { "type": ["number", "string", "null"] },
        "unit": { "type": ["string", "null"] },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "retryable": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
