# Copy to local .env, fill approved provider settings, then enable.
# Never commit the real .env or put a real key in this example.
SHIP_LLM_ENABLED=false
SHIP_LLM_PROVIDER=deepseek
SHIP_LLM_BASE_URL=https://api.deepseek.com
SHIP_LLM_MODEL=deepseek-v4-pro
SHIP_LLM_API_KEY=
SHIP_LLM_TIMEOUT_S=15

# Durable LangGraph checkpoints. Local development defaults to SQLite.
LANGGRAPH_STRICT_MSGPACK=true
SHIP_CHECKPOINT_BACKEND=sqlite
SHIP_CHECKPOINT_SQLITE_PATH=var/checkpoints.sqlite3
# Required only when SHIP_CHECKPOINT_BACKEND=postgres.
SHIP_CHECKPOINT_DATABASE_URL=

# Optional iFLYTEK streaming speech input. Keep all three values server-side.
# The browser only receives an availability flag and never receives credentials.
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_IAT_URL=wss://iat-api.xfyun.cn/v2/iat
